VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima

# Endereço em texto, como deve aparecer no convite.
VITE_EVENT_ADDRESS=

# Opcional. Se vazio, o mapa usa o endereço acima.
# Se preencher, use o endereço já codificado para a query do Google Maps.
VITE_MAPS_EMBED_QUERY=

# Opcional. Sem chave, o mapa usa o embed público.
VITE_MAPS_EMBED_KEY=

# Exemplo: 15h. Vazio também mostra 15h.
VITE_EVENT_TIME=

# Opcional. Só dígitos, com DDI. Exemplo: 5511999999999
VITE_HOST_WHATSAPP=
